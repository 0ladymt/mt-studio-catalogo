# Local development only. Copy to .env.local and never commit real values.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Server only. Obtain separately for each environment; never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
SESSION_REFRESH_MAX_AGE=2592000
GOOGLE_OAUTH_CALLBACK_URL=http://127.0.0.1:8787/api/auth/google/callback
GOOGLE_IDENTITY_LINK_CALLBACK_URL=http://127.0.0.1:8787/api/auth/google/link/callback
OAUTH_TRANSACTION_TTL_SECONDS=600
SENSITIVE_AUTHORIZATION_TTL_SECONDS=300
PUBLIC_SITE_URL=http://127.0.0.1:4173

# Optional real object-storage proof. Keep every value server-side and private.
# STORAGE_PROVIDER remains disabled until a controlled R2 test is authorized.
STORAGE_PROVIDER=disabled
LOCAL_STORAGE_ROOT=.local-storage
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_URL_TTL_SECONDS=300
STORAGE_VERIFY_MAX_BYTES=5368709120
STORAGE_VERIFY_TIMEOUT_SECONDS=1800
# Local BFF used for explicit, session-bound verifier consent.
LOCAL_VERIFIER_BFF_URL=http://127.0.0.1:8787

# Consumed by Supabase CLI through a private ignored env file in local development.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Reserved for the future cookie-based BFF session phase.
# SESSION_COOKIE_SECRET must be generated outside the repository when enabled.
